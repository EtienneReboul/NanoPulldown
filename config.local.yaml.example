# Per-machine / per-user overrides. Copy this file to config.local.yaml
# (gitignored, never committed) — the Snakefile deep-merges it on top of
# config.yaml when present.

annotate:
  interproscan:
    email: "you@yourinstitute.org"   # REQUIRED — EBI rejects requests with no contact address
  aiupred:
    docker_platform: ""              # e.g. "linux/amd64" if the AIUPred image has no arm64 build
