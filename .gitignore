config.local.yaml
data/
results/
reports/
logs/
.snakemake/
__pycache__/
*.pyc
.DS_Store
# Auto-generated per-pair experiment specs (scripts/expand_pairs.py output) --
# these accumulate one per bait x prey combination and are reproducible from
# configs/baits.txt + configs/preys.txt, so they're not tracked. The worked
# example stays tracked as the schema template (see configs/_schema.md).
configs/*.yaml
!configs/example_toy__example_toy.yaml
# Per-run output dirs from run overlays (config_<run>.yaml sets dirs: to
# results_<run>/, reports_<run>/, logs_<run>/)
results_*/
reports_*/
logs_*/
