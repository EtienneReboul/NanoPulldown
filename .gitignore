config.local.yaml
data/
results/
reports/
logs/
.snakemake/
__pycache__/
*.pyc
.DS_Store
# Auto-generated pair specs (scripts/expand_pairs.py output) -- reproducible
# from configs/baits.txt + configs/preys.txt, so not tracked. Hand-curated
# domains (configs/curated_domains.yaml) ARE tracked (see configs/_schema.md).
configs/pairs.parquet
configs/*.yaml
!configs/curated_domains.yaml
# Per-run output dirs from run overlays (config_<run>.yaml sets dirs: to
# results_<run>/, reports_<run>/, logs_<run>/)
results_*/
reports_*/
logs_*/
